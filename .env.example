# ── App Environment ─────────────────────────────────────────────────────────
# Options: development, production, test
# In production, SECRET_KEY must be a random string >= 32 characters.
APP_ENV=development

# ── Security & Authentication ────────────────────────────────────────────────
# Generate a secure 32+ character key for production (e.g. openssl rand -hex 32)
SECRET_KEY=development_super_secret_key_32_characters_long_for_local_dev
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin email (used only by scripts/seed.py to seed the admin account)
ADMIN_EMAIL=admin@example.com

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (Local development default):
DATABASE_URL=sqlite+aiosqlite:///judge.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+asyncpg://oj:oj@localhost:5432/oj

# ── Redis Queue & Rate Limiting ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_SUBMIT=20/minute

# ── Docker Judge Sandbox ────────────────────────────────────────────────────
# Image tag built via docker/Dockerfile.runner
JUDGE_IMAGE=hello-bitcoin-runner
GLOBAL_MAX_MEMORY_MB=7168
SANDBOX_MEMORY_MB=1024

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:3000,http://127.0.0.1:5500
